# OPTIONAL - only for LLM mode. The app works fully without any key.
# This app reads REAL environment variables (it does not auto-load this file), so set it in your terminal:
#   Windows PowerShell :  $env:ANTHROPIC_API_KEY="paste-your-key-here"
#   macOS / Linux      :  export ANTHROPIC_API_KEY="paste-your-key-here"
# Never put a real key in a file you commit.
ANTHROPIC_API_KEY=paste-your-key-here
# Optional: choose another Claude model for LLM mode
# CITYPULSE_MODEL=claude-sonnet-5-5
